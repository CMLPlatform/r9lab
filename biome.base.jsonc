{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "playwright": "all",
      "project": "all",
      "react": "all",
      "test": "all"
    },
    "rules": {
      "preset": "recommended",
      "a11y": "on",
      "correctness": {
        // Biome's unresolved-import scanner false-positives on Astro, package
        // export maps, and React Native tooling; type checkers own resolution.
        "noUnresolvedImports": "off"
      },
      "performance": "on",
      "security": "on",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["http://**", "https://**", "//**"],
                "message": "Do not import browser runtime JavaScript from remote or CDN URLs; install and bundle dependencies locally."
              },
              {
                // Import convention: './' only for same-directory siblings,
                // '@/' alias for everything cross-directory. Parent-relative
                // paths break when files move and hide module boundaries.
                "group": ["..", "../**"],
                "message": "Use the '@/' alias for cross-directory imports instead of parent-relative paths ('../')."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // The sites already ship light-dark() and mask-image without fallbacks,
      // so the target is Baseline newly available, not widely. An override,
      // so a subrepo's `"suspicious": "on"` does not reset the option.
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "useBaseline": { "level": "warn", "options": { "available": "newly" } }
          }
        }
      }
    },
    {
      // Standalone .svg assets are decorative icon sources; the component that
      // renders one supplies the accessible name (title/aria-label), not the file.
      "includes": ["**/*.svg"],
      "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
    },
    {
      // Test placeholders look like secrets, describe/it blocks are long without
      // being real functions, and an assertion regex matched once per run gains
      // nothing from being hoisted away from the test that documents it.
      "includes": ["**/e2e/**/*.ts", "**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveLinesPerFunction": "off" },
          // Playwright's locator.innerText() returns the text as rendered, which is
          // what the tests assert on; textContent would include hidden nodes.
          "performance": { "useDomNodeTextContent": "off", "useTopLevelRegex": "off" },
          "security": { "noSecrets": "off" },
          // Assertions often live in shared expect* helpers, and `if (!result.success)`
          // guards narrow types after the outcome is already asserted.
          "suspicious": { "noConditionalExpect": "off", "useExpect": "off" }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "html": {
    // Disabled: corrupts Astro frontmatter by inserting blank lines on every format run.
    "experimentalFullSupportEnabled": false
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  // rumdl (prek hook) owns Markdown style, and YAML is hand-formatted or
  // tool-written (pnpm-lock.yaml, prek's frozen revs). Keep Biome to code.
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "yaml": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  }
}
