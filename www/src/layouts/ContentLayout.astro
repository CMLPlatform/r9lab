---
import { getPublicSiteConfig } from '@/config/public.ts';
// Shared chrome for the site's prose pages (terms, privacy, accessibility): a
// title/meta/intro header above the page's own Markdown body. Astro passes a
// Markdown page's frontmatter here as a single `frontmatter` prop.
import Layout from '@/layouts/Layout.astro';

interface Frontmatter {
  title: string;
  description: string;
  meta?: string;
  intro?: string;
}

interface Props {
  frontmatter: Frontmatter;
}

const { title, description, meta, intro } = Astro.props.frontmatter;
const { contactEmail } = getPublicSiteConfig();
// The accessibility statement writes CONTACT_EMAIL where the address goes, so the
// address comes from deployment config, not from page copy.
const body = (await Astro.slots.render('default')).replaceAll('CONTACT_EMAIL', contactEmail);
---

<Layout title={title} description={description}>
  <div class="content-page">
    <section class="page-intro">
      <h1>{title}</h1>
      {meta && <p class="page-meta">{meta}</p>}
      {intro && <p>{intro}</p>}
    </section>
    <Fragment set:html={body} />
  </div>
</Layout>
