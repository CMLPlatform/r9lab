<mjml>
  <mj-head>
    <mj-title>Your R9lab email is verified</mj-title>
    {{include:styles}}
  </mj-head>
  <mj-body background-color="{{brand:--r9lab-brand-theme-color}}">
    {{include:header}}

    <mj-section background-color="{{brand:--r9lab-brand-background}}" padding="20px 40px">
      <mj-column>
        <mj-text font-size="16px" padding-bottom="20px"> Hello {{ username }}, </mj-text>
        <mj-text align="center" css-class="success" padding="20px 0"> Your email is verified. </mj-text>
        <mj-text> You can now sign in and add products. </mj-text>
      </mj-column>
    </mj-section>

    {{include:footer}}
  </mj-body>
</mjml>
